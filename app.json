{
  "expo": {
    "name": "AntiRog",
    "slug": "AntiRog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "antirog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.walshdsouza.antirog"
    },
    "android": {
      "package": "com.walshdsouza.antirog",
      "adaptiveIcon": {
        "backgroundColor": "#E9E0CE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withWatermelonDB.js",
      [
        "expo-notifications",
        {
          "color": "#0047E0",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AntiRog needs access to your photos so you can choose a picture of a prescription to scan.",
          "cameraPermission": "AntiRog needs camera access so you can scan prescriptions and identify pills.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AntiRog needs camera access so you can scan prescriptions and identify pills.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-fast-tflite",
      "./plugins/with-mlkit-ocr-model",
      "./plugins/with-android-shaders",
      "expo-sharing",
      "./plugins/with-widget-open-app",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "EmergencyWidget",
              "displayName": "Medical ID",
              "description": "Your blood type, allergies and emergency contact, at a glance.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular"
                ]
              },
              "android": {
                "minWidth": 180,
                "minHeight": 110,
                "targetCellWidth": 3,
                "targetCellHeight": 2,
                "resizeMode": "none"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
