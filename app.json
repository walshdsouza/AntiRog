{
  "expo": {
    "name": "AntiRog",
    "slug": "AntiRog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "antirog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.walshdsouza.antirog",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withWatermelonDB.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "AntiRog needs access to your photos so you can choose a picture of a prescription to scan.",
          "cameraPermission": "AntiRog needs camera access so you can photograph a prescription to scan.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AntiRog needs camera access so you can photograph a prescription to scan.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraGradleProperties": {
              "android.defaults.buildfeatures.buildconfig": "true"
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
